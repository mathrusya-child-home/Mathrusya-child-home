        <!-- SECTION: HOW TO HELP (DONATE) -->
        <section id="donate" class="page-section">
            <div class="section-header-banner">
                <h1>Help Us Make a Difference</h1>
                <p>Your support provides food, shelter, and a bright future for our children.</p>
            </div>

            <div class="donate-intro-text">
                <h2>Choose How You Support</h2>
                <p>Mathrusya Child Home is funded entirely through the generosity of private individuals, families, and
                    corporations. We do not rely on fixed government funding. Every rupee contributed directly helps
                    supply nutritious meals, school supplies, and safe housing for the kids.</p>
            </div>

            <!-- Sponsorship Cards Grid -->
            <div class="sponsorship-grid">

                <!-- Card 1 -->
                <div class="sponsor-card">
                    <div class="sponsor-badge p-lightorange">Most Direct</div>
                    <h3>Sponsor a Day's Meal</h3>
                    <p class="sponsor-desc">Provide healthy, home-cooked breakfast, lunch, and dinner to all children
                        and old age
                        people for a special day (like a birthday or anniversary).
                        For sponsor-price details contact us.</p>
                    <a href="#bank-details-anchor" class="btn btn-primary btn-full-width"
                        onclick="scrollToElement('bank-details-anchor')">Donate Now</a>
                </div>

                <!-- Card 2 -->
                <div class="sponsor-card featured-card">
                    <div class="sponsor-badge p-lightgreen">Highly Needed</div>
                    <h3>Sponsor a Child's Education</h3>
                    <p class="sponsor-desc">Covers school fees, transportation, textbooks, notebooks, uniform, and bags
                        for one child for an entire academic year.
                        For sponsor-price details contact us.</p>
                    <a href="#bank-details-anchor" class="btn btn-white btn-full-width"
                        onclick="scrollToElement('bank-details-anchor')">Sponsor Education</a>
                </div>

                <!-- Card 3 -->
                <div class="sponsor-card">
                    <div class="sponsor-badge p-lightblue">Monthly Care</div>
                    <h3>Sponsor Monthly Welfare</h3>
                    <p class="sponsor-desc">Contribute to a child's complete welfare package, including housing,
                        security, food, milk, clothing, and primary medical care.
                        For sponsor-price details contact us.</p>
                    <a href="#bank-details-anchor" class="btn btn-primary btn-full-width"
                        onclick="scrollToElement('bank-details-anchor')">Sponsor Monthly</a>
                </div>
            </div>

            <!-- Bank Details Box (Direct Donation) -->
            <section class="bank-details-section" id="bank-details-anchor">
                <div class="bank-details-header">
                    <h2>Direct Bank Transfer Details</h2>
                    <p>You can send donations directly via UPI or NEFT/IMPS bank transfers. All donations are
                        transparently audited.</p>
                </div>

                <div class="bank-details-grid">
                    <!-- Column 1: Bank Transfer -->
                    <div class="bank-info-box">
                        <h3>NEFT / IMPS Bank Details</h3>

                        <div class="info-row">
                            <span class="info-label">Account Name</span>
                            <div class="info-value-copy">
                                <span class="info-value" id="copy-acc-name">Mathrusya </span>
                                <button class="btn-copy" onclick="copyText('copy-acc-name', this)"
                                    aria-label="Copy account name">
                                    <span class="copy-icon">📋</span>
                                </button>
                            </div>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Bank Name</span>
                            <div class="info-value-copy">
                                <span class="info-value" id="copy-bank-name">state Bank of India </span>
                                <button class="btn-copy" onclick="copyText('copy-bank-name', this)"
                                    aria-label="Copy bank name">
                                    <span class="copy-icon">📋</span>
                                </button>
                            </div>
                        </div>

                        <div class="info-row">
                            <span class="info-label">Account Number</span>
                            <div class="info-value-copy">
                                <span class="info-value" id="copy-acc-num">42019456223</span>
                                <button class="btn-copy" onclick="copyText('copy-acc-num', this)"
                                    aria-label="Copy account number">
                                    <span class="copy-icon">📋</span>
                                </button>
                            </div>
                        </div>

                        <div class="info-row">
                            <span class="info-label">IFSC Code</span>
                            <div class="info-value-copy">
                                <span class="info-value" id="copy-ifsc">SBIN0021060</span>
                                <button class="btn-copy" onclick="copyText('copy-ifsc', this)"
                                    aria-label="Copy IFSC code">
                                    <span class="copy-icon">📋</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: UPI / QR Code -->
                    <div class="bank-info-box text-center justify-center">
                        <h3>UPI / QR Code Transfer</h3>

                        <div class="upi-id-box">
                            <span class="upi-label">UPI ID</span>
                            <div class="info-value-copy centered-copy">
                                <span class="info-value" id="copy-upi">9700440415@ybl</span>
                                <button class="btn-copy" onclick="copyText('copy-upi', this)" aria-label="Copy UPI ID">
                                    <span class="copy-icon">📋</span>
                                </button>
                            </div>
                        </div>

                        <div class="qr-placeholder">
                            <!-- QR Code Image Section -->
                            <div class="qr-container">
                                <img src="assets/QR.jpeg" alt="UPI QR Code" class="qr-image">
                                <p class="qr-sub"></p>
                                Scan using any UPI App (GPay, PhonePe, Paytm)
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="tax-exemption-note">
                        <p>💡 <strong>Note:</strong> Once you make a transfer, please send the transaction receipt
                            screenshot to <strong>+91 97004 40415 or 86862 65143</strong> via WhatsApp or email us so we
                            can verify the
                            funds. Thank you!</p>
                    </div>
            </section>
        </section>


        <!-- SECTION: CONTACT US -->
        <section id="contact" class="page-section">
            <div class="section-header-banner">
                <h1>Contact Us</h1>
                <p>We welcome you to visit us, volunteer, or reach out with questions.</p>
            </div>

            <div class="contact-grid">

                <!-- Contact Information -->
                <div class="contact-info">
                    <h2>Get In Touch</h2>
                    <p>Have questions about sponsoring children, visiting, or volunteering? Fill out the form or reach
                        out directly through phone or email.</p>

                    <div class="contact-details-list">

                        <div class="contact-detail-card">
                            <div class="contact-icon-circle">
                                📞
                            </div>
                            <div class="contact-detail-text">
                                <h4>Phone / Whatsapp</h4>
                                <p><a href="tel:+919700440415">+91 97004 40415</a></p>
                                <p><a href="tel:+918686265143">+91 86862 65143</a></p>
                            </div>
                        </div>

                        <div class="contact-detail-card">
                            <div class="contact-icon-circle">
                                ✉️
                            </div>
                            <div class="contact-detail-text">
                                <h4>Email Address</h4>
                                <p><a href="mailto:Mathrusya2014@gmail.com">Mathrusya2014@gmail.com</a></p>
                            </div>
                        </div>

                        <div class="contact-detail-card">
                            <div class="contact-icon-circle">
                                📍
                            </div>
                            <div class="contact-detail-text">
                                <h4>Office & Home Address</h4>
                                <p>Sai Nagar, M.K. Naidu Colony,
                                    Bairagi patteda, Tirupati,Andhra Pradesh 517501, India</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Styled Map representation -->
                <section class="map-section">
                    <h2>Our Location Map</h2>
                    <p>Located in the heart of Tirupati, close to Bairagi Patteda area, easily accessible from Tirupati
                        Bus
                        Stand and Railway Station.</p>

                    <div class="map-container-mock">
                        <!-- Google Maps Iframe Embed for Tirupati (specifically Bairagi Patteda area) -->
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3877.012!2d79.421598!3d13.6162513!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3a4d4b7701388271%3A0xe801b0ae204f0f10!2sMathrusya%20Child%20Home!5e0!3m2!1sen!2sin!4v1720966453912!5m2!1sen!2sin"
                            width="100%" height="450" style="border:0; border-radius: 12px; box-shadow: var(--shadow);"
                            allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </section>
        </section>
