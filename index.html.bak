<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mathrusya Child Home | Hope, Care & Education for Underprivileged Children</title>
    <meta name="description"
        content="Mathrusya Child Home is a charitable orphanage in Tirupati, Andhra Pradesh, providing shelter, care, nutrition, and education for underprivileged children since 2007.">
    <link rel="stylesheet" href="styles.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Favicon Icon -->
    <link rel="icon" type="image/png" href="assets/logo.png">
</head>

<body>

    <!-- Header Navigation -->
    <header class="header">
        <div class="header-container">
            <a href="#home" class="logo-container" id="nav-logo">
                <img src="assets/LOGO MATHRUSYA.png" alt="Mathrusya Child Home Logo" class="nav-logo-img">
                <div class="logo-text">
                    <span class="logo-title">Mathrusya</span>
                    <span class="logo-subtitle">Child Home</span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="nav-menu" id="nav-menu">
                <a href="#home" class="nav-link active" data-page="home">Home</a>
                <a href="#about" class="nav-link" data-page="about">About Us</a>
                <a href="#children" class="nav-link" data-page="children">Our Children</a>
                <a href="#gallery" class="nav-link" data-page="gallery">Gallery</a>
                <a href="#donate" class="nav-link btn-donate-nav" data-page="donate">How to Help</a>
                <a href="#contact" class="nav-link" data-page="contact">Contact Us</a>
            </nav>

            <!-- Mobile Menu Toggle Button -->
            <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle navigation menu">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="main-content">

        <!-- SECTION: HOME -->
        <section id="home" class="page-section active">
            <!-- Hero Layout -->
            <div class="hero-section">
                <div class="hero-container">
                    <div class="hero-info">
                        <span class="hero-tagline">Providing Shelter, Hope & Dignity Since 2007</span>
                        <h1 class="hero-title">Every Child Deserves a <span class="highlight">Bright Future</span></h1>
                        <p class="hero-desc">Mathrusya Child Home is a safe haven in Tirupati, dedicated to nurturing,
                            educating, and supporting orphan and underprivileged children, helping them become
                            independent citizens.</p>
                        <div class="hero-actions">
                            <a href="#donate" class="btn btn-primary" onclick="navigateToPage('donate')">Sponsor a
                                Child</a>
                            <a href="#about" class="btn btn-secondary" onclick="navigateToPage('about')">Our Story</a>
                        </div>
                    </div>
                    <div class="hero-visual">
                        <div class="hero-slideshow-container">
                            <div class="hero-slideshow" id="hero-slideshow">
                                <div class="slide active">
                                    <img src="assets/group-1.jpeg" alt="Happy children care and family"
                                        class="slide-img">
                                </div>
                                <div class="slide">
                                    <img src="assets/food_2.webp" alt="Food service for children" class="slide-img">
                                </div>
                                <div class="slide">
                                    <img src="assets/celebration-1.jpeg" alt="Festival Celebrations and Events"
                                        class="slide-img">
                                </div>
                                <div class="slide">
                                    <img src="assets/education_1.webp" alt="Learning and Educational Support"
                                        class="slide-img">
                                </div>
                                <div class="slide">
                                    <img src="assets/health.webp" alt="Health Care Community" class="slide-img">
                                </div>
                                <div class="slide">
                                    <img src="assets/service-4.png" alt="Funeral service" class="slide-img">
                                </div>
                            </div>

                            <!-- Slideshow Navigation Buttons -->
                            <button class="slideshow-btn prev-btn" id="hero-prev-btn"
                                aria-label="Previous Slide">&#10094;</button>
                            <button class="slideshow-btn next-btn" id="hero-next-btn"
                                aria-label="Next Slide">&#10095;</button>

                            <!-- Slideshow Pagination Dots -->
                            <div class="slideshow-dots" id="hero-slideshow-dots">
                                <span class="dot active"></span>
                                <span class="dot"></span>
                                <span class="dot"></span>
                                <span class="dot"></span>
                                <span class="dot"></span>
                                <span class="dot"></span>
                            </div>

                            <!-- Floating Badge -->
                            <div class="floating-badge badge-top">
                                <span class="badge-icon">&#10084;&#65039;</span>
                                <div class="badge-text">
                                    <p class="badge-num">120+</p>
                                    <p class="badge-label">Children &amp; Old Age People</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>

            <!-- Stats Bar Section -->
            <section class="stats-section">
                <div class="stats-container">
                    <div class="stat-card">
                        <h3 class="stat-number" data-target="18">0</h3>
                        <p class="stat-label">Years of Care</p>
                    </div>
                    <div class="stat-card">
                        <h3 class="stat-number" data-target="150">0</h3>
                        <p class="stat-label">Children & Old Age Peoplein Home</p>
                    </div>
                    <div class="stat-card">
                        <h3 class="stat-number" data-target="100">0</h3>
                        <span class="stat-suffix">%</span>
                        <p class="stat-label">Care & Safety</p>
                    </div>
                    <div class="stat-card">
                        <h3 class="stat-number" data-target="50">0</h3>
                        <span class="stat-suffix">+</span>
                        <p class="stat-label">Volunteers & Donors</p>
                    </div>
                </div>
            </section>

            <!-- Quick Info / Pillars Section -->
            <section class="pillars-section">
                <div class="section-title-wrapper">
                    <span class="section-tag">How We Support</span>
                    <h2 class="section-title">Our Core Pillars of Care</h2>
                    <p class="section-subtitle">We believe that physical care, mental development, and education are the
                        foundational rights of every child.</p>
                </div>
                <div class="pillars-grid">
                    <div class="pillar-card">
                        <div class="pillar-icon-wrapper p-orange">
                            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path
                                    d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                            </svg>
                        </div>
                        <h3>Nutritional Food</h3>
                        <p>We provide three hygienic, balanced meals daily, tailored to meet the growing nutritional
                            needs of children.</p>
                    </div>
                    <div class="pillar-card">
                        <div class="pillar-icon-wrapper p-green">
                            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                        </div>
                        <h3>Safe Shelter</h3>
                        <p>A safe, warm, and loving residential environment with clean facilities and full-time security
                            and supervision.</p>
                    </div>
                    <div class="pillar-card">
                        <div class="pillar-icon-wrapper p-blue">
                            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
                            </svg>
                        </div>
                        <h3>Quality Education</h3>
                        <p>Enrolling all children in local schools and providing additional STEM education, libraries,
                            and coaching support.</p>
                    </div>
                    <div class="pillar-card">
                        <div class="pillar-icon-wrapper p-yellow">
                            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                            </svg>
                        </div>
                        <h3>Healthcare & Therapy</h3>
                        <p>Regular health checkup camps, psychological wellness workshops, and specialized counseling or
                            therapies.</p>
                    </div>
                </div>
            </section>

            <!-- Recent Activities & Highlights -->
            <section class="highlights-section">
                <div class="section-title-wrapper">
                    <span class="section-tag">Updates </span>
                    <h2 class="section-title">Latest Activities at Mathrusya</h2>
                </div>
                <div class="highlights-grid">
                    <div class="activity-card">
                        <div class="activity-img-wrapper">
                            <img src="assets/serve-2.webp" alt="Daily food Distribution" class="activity-img">
                            <span class="activity-date">2026</span>
                        </div>
                        <div class="activity-content">
                            <h3>Daily food Distribution</h3>
                            <p>We provide free daily meals to homeless and needy people outside our orphanage.
                                Through this initiative, we aim to serve humanity with love, care, and compassion.</p>
                        </div>
                    </div>
                    <div class="activity-card">
                        <div class="activity-img-wrapper">
                            <!-- High quality Unsplash placeholder for health camp -->
                            <img src="assets/health.webp" alt="Health Camp" class="activity-img">
                            <span class="activity-date"> 2026</span>
                        </div>
                        <div class="activity-content">
                            <h3>Annual Health & Wellness Camp</h3>
                            <p>A team of children's doctors and dentists conducted a complete health check-up camp for
                                the children.
                                Free medicines and nutritional supplements were also given to the children.</p>
                        </div>
                    </div>
                    <div class="activity-card">
                        <div class="activity-img-wrapper">
                            <!-- High quality Unsplash placeholder for festival -->
                            <img src="assets/independence day.jpeg" alt="Independence day Celebrations"
                                class="activity-img">
                            <span class="activity-date">August 15, 2026</span>
                        </div>
                        <div class="activity-content">
                            <h3>Independence day Celebrations</h3>
                            <p>We proudly celebrated Independence Day at our orphanage with great joy and patriotism.
                                The children participated in flag hoisting, cultural activities, and celebrations.</p>
                        </div>
                    </div>
                </div>
            </section>
        </section>


        <!-- SECTION: ABOUT US -->
        <section id="about" class="page-section">
            <div class="section-header-banner">
                <h1>About Mathrusya</h1>
                <p>Learn about our roots, our mission, and the people behind this home.</p>
            </div>

            <div class="about-story-container">
                <div class="about-story-text">
                    <h2>Our Story</h2>
                    <p>Established in <strong>2007</strong> in Tirupati, Andhra Pradesh,dedicated to serving humanity
                        with love and compassion.
                        What began as a small initiative to support a few orphan children has grown over the past two
                        decades into a structured
                        and registered charitable trust serving underprivileged, homeless, and needy people.We believe
                        in creating a caring,
                        family-like environment where every individual is treated with dignity, love, and respect. Our
                        mission is to provide
                        essential support, security, nutrition, education, and emotional care to those in need.</p>

                    <div class="quote-box">
                        <p class="quote-text">"Every orphan child deserves the same warmth, care, and quality education
                            as any other child. We are not just a shelter; we are a family.we are home."</p>
                        <p class="quote-author">— Dr.T.Sridevi, Founder</p>
                    </div>
                </div>
                <div class="about-story-image">
                    <img src="assets/group-2.webp" alt="Mathrusya Child Home Building" class="about-img shadow-effect">
                </div>
            </div>

            <!-- Founder Section -->
            <section class="founder-section">
                <div class="founder-card-inner">
                    <h2>The Visionary Behind the Mission</h2>
                    <div class="founder-profile-grid">
                        <div class="founder-photo-box">
                            <img src="assets/owner.webp" alt="T SRIDEVI" class="founder-img">
                        </div>
                        <div class="founder-bio">
                            <h3>DR.T.SRIDEVI</h3>
                            <p class="founder-title">Founder & Managing Trustee</p>
                            <p>DR.T.Sridevi director and founder of mathrusya non governmental organization which is
                                abode
                                of 120 children and oldage people.Located in Bairagipatteda , Tirupathi, Andhrapradesh .
                                When i am 12 me with my father went to my relatives marriage and when on the way in
                                return
                                to our home one carpenter is beating a kid who is 10 years old very ruthlessly and that
                                boy
                                is screaming loudly ,but no one came to help him and to stop carpenter ,then i asked my
                                father why that he is beating very cruely and nobody is coming to stop him why ?
                                Then my father replied if something happens to you i am there to take care of you but
                                he doesn't have anyone like you , then it realized me that if child is orphan
                                everyone will have rights on him except the child him self another situation ,which
                                felt me very doleful is after my marriage I went to Tirumala , afterfinishing the
                                darshan
                                we came out of temple somebody had dragged my son from hands and ran away and those
                                people
                                were changing my son into many hands and finally by chasing them i received my son back
                                .
                                From this situation i came to know that it is quite common in cities and those children
                                who will be thefted will be sent as beggers by making them handicapped. It really made
                                my
                                heart very mournful.by facing this situation i became very sensitive and i used to help
                                many
                                people finally 14 children were used to be with meby seeing me some officers did quiry
                                about
                                me and they acknowledged me about official process and registered as Mathrusya.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Core Values -->
            <section class="values-section">
                <h2 class="section-title text-center">Our Core Values</h2>
                <div class="values-grid">
                    <div class="value-card">
                        <div class="value-icon">❤️</div>
                        <h3>Compassion </h3>
                        <p>We serve every person with kindness,
                            empathy, and love.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">🎓</div>
                        <h3>Education & Growth</h3>
                        <p>We promote quality education, creativity,
                            logical thinking, physical development, and lifelong learning.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">🛡️</div>
                        <h3>Safety & Security</h3>
                        <p>We are committed to providing a safe and secure environment
                            for those under our care.</p>
                    </div>
                    <div class="value-card">
                        <div class="value-icon">🏠</div>
                        <h3>Family & Belonging</h3>
                        <p>We create a safe, loving, and supportive environment
                            where everyone feels valued.</p>
                    </div>
                </div>
            </section>
        </section>


        <!-- SECTION: OUR CHILDREN -->
        <section id="children" class="page-section">
            <div class="section-header-banner">
                <h1>Our Children & Development</h1>
                <p>Nurturing children, enriching minds, and building characters.</p>
            </div>

            <div class="children-intro-grid">
                <div class="children-intro-visual">
                    <img src="assets/education _2.webp" alt="Students in a classroom"
                        class="children-img shadow-effect">
                </div>
                <div class="children-intro-text">
                    <h2>Nurturing the Next Generation</h2>
                    <p>At Mathrusya, our children are aged between 1 and 25 years. We believe their developmental
                        journey should include more than basic shelter. We ensure every child receives balanced growth
                        in all aspects of life:</p>

                    <div class="bullet-list-desc">
                        <div class="bullet-item">
                            <span class="bullet-check">✓</span>
                            <div>
                                <strong>School Education:</strong> Enrolled in regional and private English-medium
                                schools, with full support for tuition, uniforms, and textbooks.
                            </div>
                        </div>
                        <div class="bullet-item">
                            <span class="bullet-check">✓</span>
                            <div>
                                <strong>Sports & Co-curricular:</strong> Regular sports equipment, drawing, painting,
                                music, and yoga training to boost physical and mental health.
                            </div>
                        </div>
                        <div class="bullet-item">
                            <span class="bullet-check">✓</span>
                            <div>
                                <strong>Hygiene and Health:</strong> Regular pediatric checkups, nutritional
                                supplements, and hygiene workshops.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Daily Schedule -->
            <section class="schedule-section">
                <h2 class="section-title text-center">A Day in the Life at Mathrusya</h2>
                <p class="section-subtitle text-center">A structured routine is maintained to instill discipline and
                    build healthy habits.</p>

                <div class="timeline">
                    <div class="timeline-item">
                        <div class="time-marker">06:00 AM</div>
                        <div class="timeline-content">
                            <h3>Rise, Yoga & Meditation</h3>
                            <p>Children start their day with mild exercise and yoga, fostering mindfulness and physical
                                health.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="time-marker">08:00 AM</div>
                        <div class="timeline-content">
                            <h3>Hygienic Breakfast</h3>
                            <p>A nutritious breakfast (like Idli, Dosa, or Upma) is served alongside fresh milk.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="time-marker">08:45 AM</div>
                        <div class="timeline-content">
                            <h3>School Hours</h3>
                            <p>Children attend school, dressed in neat uniforms, driven and supported by the home's
                                supervisors.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="time-marker">04:30 PM</div>
                        <div class="timeline-content">
                            <h3>Snacks & Playground Time</h3>
                            <p>Healthy evening snacks followed by open play time in the garden and neighborhood
                                playground.</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="time-marker">05:30 PM</div>
                        <div class="timeline-content">
                            <h3>Study Hours </h3>
                            <p>Home tutors and volunteers assist children with school homework </p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="time-marker">08:00 PM</div>
                        <div class="timeline-content">
                            <h3>Dinner & Sleep</h3>
                            <p>A healthy dinner of rice, dal, and vegetables. Followed by relaxation time and lights out
                                by 9:30 PM.</p>
                        </div>
                    </div>
                </div>
            </section>
        </section>


        <!-- SECTION: GALLERY -->
        <section id="gallery" class="page-section">
            <div class="section-header-banner">
                <h1>Memory Gallery</h1>
                <p>Moments of joy, learning, and sharing captured in pictures.</p>
            </div>

            <div class="gallery-wrapper">
